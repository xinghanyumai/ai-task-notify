# ---------------------------------------------------------------- 凭证
# 真实配置里有 appid / appsecret / openid / webhook key，绝不入库。
# 新克隆的仓库请复制 config.example.json 为 config.json 再填写。
config.json
config.json.tmp
*.secret.json

# ---------------------------------------------------------------- 运行时数据
# state/ 含 access_token、模板缓存、会话记录；logs/ 含通知正文。
# 目录本身用 .gitkeep 占位，其余全部忽略。
state/*
!state/.gitkeep
logs/*
!logs/.gitkeep
*.log

# ---------------------------------------------------------------- 临时文件
*.tmp
*.bak
*.bak-*
*.orig
*.rej
*~

# ---------------------------------------------------------------- Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------- 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
.claude/

# ---------------------------------------------------------------- Agent 工具本地数据
.workbuddy-ai/
.codebuddy/

# ---------------------------------------------------------------- 系统
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- 截图草稿
# shot.py 不带参数跑时的默认输出，不是要提交的资产
assets/_shot.png
